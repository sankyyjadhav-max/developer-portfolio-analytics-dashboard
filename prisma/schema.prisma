generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  portfolio Portfolio?
}

model Portfolio {
  id           String   @id @default(cuid())
  userId       String   @unique
  slug         String   @unique
  name         String
  headline     String   @default("Developer")
  bio          String   @default("")
  profileImage String?
  location     String?
  contactEmail String?
  phone        String?
  githubUrl    String?
  linkedinUrl  String?
  twitterUrl   String?
  websiteUrl   String?
  resumeUrl    String?
  template     String   @default("modern")
  theme        String   @default("dark")
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    Project[]
  skills      Skill[]
  experiences Experience[]
  educations  Education[]
  events      AnalyticsEvent[]

  @@index([userId])
}

model Project {
  id           String   @id @default(cuid())
  portfolioId  String
  title        String
  description  String
  image        String?
  technologies String
  githubUrl    String?
  liveUrl      String?
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolio Portfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  events    AnalyticsEvent[]

  @@index([portfolioId])
}

model Skill {
  id          String @id @default(cuid())
  portfolioId String
  name        String
  category    String
  level       Int    @default(70)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Experience {
  id          String  @id @default(cuid())
  portfolioId String
  company     String
  role        String
  description String
  startDate   String
  endDate     String?
  current     Boolean @default(false)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model Education {
  id          String  @id @default(cuid())
  portfolioId String
  institution String
  degree      String
  field       String
  startDate   String
  endDate     String?
  description String

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model AnalyticsEvent {
  id              String   @id @default(cuid())
  portfolioId     String
  projectId       String?
  eventType       String
  page            String
  visitorId       String
  sessionId       String
  referrer        String?
  country         String   @default("Unknown")
  state           String   @default("Unknown")
  city            String   @default("Unknown")
  device          String   @default("Unknown")
  browser         String   @default("Other")
  operatingSystem String   @default("Other")
  userAgent       String?
  timestamp       DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([portfolioId, timestamp])
  @@index([portfolioId, eventType, timestamp])
  @@index([portfolioId, visitorId])
  @@index([projectId, timestamp])
}
